{
  "name": "redundans/weekly-popular",
  "description": "Flarum 2.0 extension that ranks discussions by recent activity in the last week.",
  "type": "flarum-extension",
  "require": {
    "php": "^8.1",
    "flarum/core": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Redundans\\WeeklyPopular\\": "src/"
    }
  },
  "extra": {
    "flarum-extension": {
      "title": "Weekly Popular",
      "category": "discussion",
      "icon": {
        "name": "fas fa-fire",
        "backgroundColor": "#f59e0b",
        "color": "#fff7ed"
      },
      "sort": {
        "name": "weekly-popular",
        "label": "Popular (7d)"
      }
    }
  }
}
